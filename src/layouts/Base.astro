---
import StickerSprite from '../components/StickerSprite.astro';
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/caveat';
import '../styles/tokens.css';
import '../styles/site.css';

const title = "Places We've Been: an open-source family travel scrapbook";
const description = 'A paper globe of every trip your family takes, with journals, photos and stories. Self-hosted on Cloudflare’s free plan, and private to the people you choose.';
const og = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FDF2EA" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Places We've Been" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <StickerSprite />
    <slot />
  </body>
</html>
